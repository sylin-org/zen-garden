# Local koi development override.
#
# Copy this file to `config.local.toml` (gitignored) to build against a sibling
# `../koi` checkout instead of the koi crates published on crates.io. The main
# `.cargo/config.toml` pulls it in via an optional `include`, so this opt-in
# never affects clean clones.
#
# Paths resolve relative to the repo root (the parent of `.cargo/`). Every koi
# crate in the dependency tree is patched, so local edits to any of them —
# including transitive crates — are picked up.

[patch.crates-io]
koi-certmesh   = { path = "../koi/crates/koi-certmesh" }
koi-client     = { path = "../koi/crates/koi-client" }
koi-common     = { path = "../koi/crates/koi-common" }
koi-config     = { path = "../koi/crates/koi-config" }
koi-crypto     = { path = "../koi/crates/koi-crypto" }
koi-dns        = { path = "../koi/crates/koi-dns" }
koi-embedded   = { path = "../koi/crates/koi-embedded" }
koi-health     = { path = "../koi/crates/koi-health" }
koi-mdns       = { path = "../koi/crates/koi-mdns" }
koi-proxy      = { path = "../koi/crates/koi-proxy" }
koi-runtime    = { path = "../koi/crates/koi-runtime" }
koi-truststore = { path = "../koi/crates/koi-truststore" }
koi-udp        = { path = "../koi/crates/koi-udp" }
