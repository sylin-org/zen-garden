{
  "name": "comfyui",
  "description": "ComfyUI node-based image generation — Stable Diffusion, Flux, and more. Auto-selects NVIDIA/AMD/CPU.",
  "category": "ai",
  "tags": [
    "ai",
    "image-generation",
    "stable-diffusion",
    "flux",
    "comfyui",
    "gpu",
    "cuda",
    "rocm"
  ],
  "port": 8188,
  "modes": ["managed"],
  "volumes": [
    "comfyui-models",
    "comfyui-hf-cache",
    "comfyui-custom-nodes",
    "comfyui-pip-local",
    "comfyui-input",
    "comfyui-output",
    "comfyui-user",
    "comfyui-cache",
    "comfyui-config",
    "comfyui-scripts"
  ],
  "gpu_recommended": true,
  "minimum_memory_gb": 8,
  "connection": {
    "protocol": "http",
    "uri_template": "http://{host}:{port}"
  },
  "manageable_env": {
    "service_name": "comfyui",
    "restart_required": true,
    "vars": [
      "CLI_ARGS"
    ]
  }
}
