{
  "version": 1,
  "name": "image.img2img",
  "display_name": "Transform",
  "capability": "image",
  "description": "Transform an image guided by a text prompt",
  "provider_kind": "comfy_ui",
  "vram_mb": 4096,
  "default_workflow": "img2img",

  "content_slots": [
    { "role": "source", "content_type": "image", "required": true },
    { "role": "prompt", "content_type": "text", "required": true }
  ],

  "mappings": [
    { "type": "content", "role": "source", "content_type": "image",
      "placeholder": "PLACEHOLDER_IMAGE" },

    { "type": "content", "role": "prompt", "content_type": "text",
      "placeholder": "PLACEHOLDER_PROMPT" },

    { "type": "param", "field": "negative", "label": "Negative Prompt",
      "placeholder": "PLACEHOLDER_NEGATIVE", "param_type": "text",
      "default": "blurry, watermark, low quality" },

    { "type": "param", "field": "checkpoint", "label": "Model",
      "placeholder": "PLACEHOLDER_CHECKPOINT", "param_type": "options",
      "options": [
        { "value": "v1-5-pruned-emaonly.safetensors" }
      ],
      "default": "v1-5-pruned-emaonly.safetensors" },

    { "type": "param", "field": "strength", "label": "Strength",
      "node": "6", "input": "denoise", "param_type": "range",
      "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.7 },

    { "type": "param", "field": "steps", "label": "Steps",
      "node": "6", "input": "steps", "param_type": "range",
      "min": 1, "max": 50, "step": 1, "default": 20 },

    { "type": "param", "field": "seed", "label": "Seed",
      "node": "6", "input": "seed", "param_type": "auto",
      "kind": "random_int" }
  ],

  "required_models": [
    {
      "filename": "v1-5-pruned-emaonly.safetensors",
      "model_type": "checkpoints",
      "url": "https://huggingface.co/stable-diffusion-v1-5/stable-diffusion-v1-5/resolve/main/v1-5-pruned-emaonly.safetensors",
      "size_bytes": 4265380512,
      "license": "CreativeML Open RAIL-M",
      "description": "Stable Diffusion 1.5 — versatile, runs on 4GB+ VRAM."
    }
  ]
}
