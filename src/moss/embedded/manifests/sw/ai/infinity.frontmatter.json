{
  "name": "infinity",
  "description": "Infinity — high-throughput embedding and reranking server (MIT)",
  "category": "ai",
  "tags": [
    "ai",
    "embeddings",
    "reranking",
    "vector",
    "semantic-search",
    "openai-compatible",
    "clip",
    "sentence-transformers"
  ],
  "port": 7997,
  "volumes": ["infinity-models"],
  "gpu_recommended": true,
  "minimum_memory_gb": 2,
  "connection": {
    "uri_template": "http://{host}:{port}"
  },
  "manageable_env": {
    "service_name": "infinity",
    "restart_required": true,
    "vars": [
      "INFINITY_MODEL_ID",
      "INFINITY_BATCH_SIZE",
      "INFINITY_API_KEY",
      "INFINITY_ANONYMOUS_USAGE_STATS"
    ]
  }
}
