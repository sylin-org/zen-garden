{
  "version": 2,
  "name": "vision.tag",
  "display_name": "Tag Image",
  "capability": "vision",
  "description": "Analyze an image and generate descriptive tags using WD14 Tagger",
  "provider_kind": "comfy_ui",
  "vram_mb": 512,
  "default_workflow": "tag",

  "content_slots": [
    { "role": "source", "content_type": "image", "required": true }
  ],

  "mappings": [
    { "type": "content", "role": "source", "content_type": "image",
      "placeholder": "PLACEHOLDER_IMAGE" },

    { "type": "param", "field": "model", "label": "Tagger Model",
      "node": "2", "input": "model",
      "param_type": "options",
      "options": [
        { "value": "wd-v1-4-moat-tagger-v2", "label": "MOAT v2 (Default)" },
        { "value": "wd-swinv2-tagger-v3", "label": "SwinV2 v3 (Best)" },
        { "value": "wd-vit-tagger-v3", "label": "ViT v3 (Fast)" },
        { "value": "wd-eva02-large-tagger-v3", "label": "EVA02 Large v3 (Highest Quality)" },
        { "value": "wd-convnext-tagger-v3", "label": "ConvNeXt v3" }
      ],
      "default": "wd-v1-4-moat-tagger-v2" },

    { "type": "param", "field": "threshold", "label": "Confidence Threshold",
      "node": "2", "input": "threshold",
      "param_type": "range",
      "min": 0.1, "max": 0.9, "step": 0.05,
      "default": 0.35 },

    { "type": "param", "field": "character_threshold", "label": "Character Threshold",
      "node": "2", "input": "character_threshold",
      "param_type": "range",
      "min": 0.1, "max": 0.9, "step": 0.05,
      "default": 0.85 },

    { "type": "param", "field": "exclude_tags", "label": "Exclude Tags",
      "node": "2", "input": "exclude_tags",
      "param_type": "text",
      "default": "" }
  ],

  "required_models": []
}
