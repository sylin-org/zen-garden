  "volumes": ["harbor-data", "harbor-database", "harbor-redis"],
  "connection_template": "http://{host}:{port}/v2/",
  "minimum_memory_mb": 1024,
  "deployment_type": "advanced",
  "requires": ["postgresql", "redis"]
