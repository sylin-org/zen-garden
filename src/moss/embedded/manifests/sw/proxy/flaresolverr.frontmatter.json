{
  "name": "flaresolverr",
  "description": "Proxy server that bypasses Cloudflare/DDoS-Guard challenges for *arr indexers (MIT)",
  "category": "proxy",
  "tags": ["proxy", "cloudflare", "scraping", "indexer", "arr"],
  "port": 8191,
  "homepage": "https://github.com/FlareSolverr/FlareSolverr",
  "documentation": "https://github.com/FlareSolverr/FlareSolverr#usage",
  "connection": { "protocol": "http", "uri_template": "http://{host}:{port}" },
  "coordination": "independent",
  "manageable_env": {
    "service_name": "flaresolverr",
    "restart_required": true,
    "vars": ["LOG_LEVEL", "CAPTCHA_SOLVER", "TZ", "PROXY_URL", "DISABLE_MEDIA"]
  }
}
