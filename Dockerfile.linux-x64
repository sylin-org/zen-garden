# Build container for Zen Garden Linux binaries
# NOTE: After changing this file, rebuild with: -ForceRebuild flag
FROM rust:latest AS builder

WORKDIR /build

# Install dependencies (clang + mold for fast linking, configured in .cargo/config.toml)
RUN apt-get update && apt-get install -y \
    musl-tools \
    file \
    libasound2-dev \
    libudev-dev \
    pkg-config \
    clang \
    mold \
    && rm -rf /var/lib/apt/lists/*

# Source code is mounted as a volume at runtime via -v flag
# No COPY needed - workspace is mapped to /build

# Build release binaries
# Note: Default builds debug, pass --release for optimized
CMD ["bash", "-c", "cargo build --bin garden-moss && cargo build --bin garden-rake"]


