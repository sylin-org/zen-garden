# Zen Garden Development Environment
# Copy to .env and customize for local development
# .env is gitignored and won't be committed

# === Adapter Development ===
# Point to local build output instead of installed path
GARDEN_ADAPTERS_DIR=./target/adapters

# === Data/Config Paths ===
# Override default paths for development
# GARDEN_DATA_DIR=./.zen-garden
# GARDEN_CONFIG_DIR=./.zen-garden/config

# === Endpoints ===
# Skip discovery and connect directly to a specific stone
# GARDEN_STONE=http://localhost:7185

# === Debugging ===
# RUST_LOG=debug
# RUST_BACKTRACE=1
