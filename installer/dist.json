{
  "$schema": "./dist.schema.json",
  "version": "2.1",
  "description": "Zen Garden distribution - mirrors target filesystem structure",

  "workspace": {
    "root": "..",
    "dist": "../dist"
  },

  "staging": {
    "linux": "../dist/staging/linux",
    "windows": "../dist/staging/windows"
  },

  "packages": {
    "outputDir": "../dist/packages",
    "format": {
      "linux": "tar.gz",
      "windows": "zip"
    }
  },

  "tiers": {
    "core": ["moss", "rake"],
    "full": ["moss", "rake", "lantern", "cricket", "firefly"]
  },

  "binaries": {
    "moss": {
      "source": "garden-moss",
      "destination": "bin/",
      "required": true,
      "tier": "core",
      "platforms": ["linux", "windows"]
    },
    "rake": {
      "source": "garden-rake",
      "destination": "bin/",
      "required": true,
      "tier": "core",
      "platforms": ["linux", "windows"]
    },
    "lantern": {
      "source": "garden-lantern",
      "destination": "bin/",
      "required": false,
      "tier": "full",
      "platforms": ["linux", "windows"]
    },
    "cricket": {
      "source": "garden-cricket",
      "destination": "bin/companions/cricket/",
      "required": false,
      "tier": "full",
      "platforms": ["linux", "windows"]
    },
    "firefly": {
      "source": "garden-firefly",
      "destination": "bin/companions/firefly/",
      "required": false,
      "tier": "full",
      "platforms": ["linux", "windows"]
    }
  },

  "assets": {
    "scripts": {
      "source": "installer",
      "destination": "bin/",
      "files": [
        "garden-upgrade.sh",
        "moss-update-helper.sh"
      ],
      "lineEndings": "lf",
      "platforms": ["linux"]
    },
    "gardenConfig": {
      "source": "installer",
      "destination": "lib/zen-garden/",
      "files": ["garden.conf"],
      "lineEndings": "lf",
      "platforms": ["linux"]
    }
  },
  
  "build": {
    "profiles": {
      "debug": {
        "cargo": "--profile dev"
      },
      "fast-release": {
        "cargo": "--profile fast-release"
      },
      "release": {
        "cargo": "--release"
      }
    },
    "defaultProfile": "fast-release",
    "jobs": 0
  },
  
  "linux": {
    "buildScript": "dist-linux.ps1",
    "distDir": "../dist/linux",
    "architecture": "amd64"
  },
  
  "windows": {
    "buildScript": "dist-windows.ps1",
    "distDir": "../dist/windows",
    "architecture": "amd64"
  }
}
