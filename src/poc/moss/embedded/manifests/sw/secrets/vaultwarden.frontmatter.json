{
  "name": "vaultwarden",
  "description": "Bitwarden-compatible password and secrets vault — lightweight Rust server (AGPL-3.0)",
  "category": "secrets",
  "tags": ["passwords", "secrets", "bitwarden", "vault"],
  "port": 80,
  "homepage": "https://github.com/dani-garcia/vaultwarden",
  "documentation": "https://github.com/dani-garcia/vaultwarden/wiki",
  "connection": { "protocol": "http", "uri_template": "http://{host}:{port}" },
  "coordination": "independent",
  "manageable_env": {
    "service_name": "vaultwarden",
    "restart_required": true,
    "vars": ["DOMAIN", "SIGNUPS_ALLOWED", "ADMIN_TOKEN"]
  }
}
