{
  "$schema": "./zen-garden-uri-test-vectors.schema.json",
  "version": 1,
  "spec": "URI-0003",
  "description": "Conformance corpus for zen-garden: URI parsers. Both the Rust (garden-common) and C# (Koan.ZenGarden.Core) implementations MUST pass every case in this file. Any new URI shape added to URI-0003 MUST add corresponding entries here in the same change.",
  "fields": {
    "uri": "Input string passed to the parser",
    "parses": "Whether the parser accepts the input. When false, error is set",
    "error": "Error category for parse failures: invalid_scheme, empty_target_no_cap, reserved_name_collision, malformed_query, unsupported_version",
    "kind_explicit": "true if URI uses <kind>//<name> form; false for bare name or empty target",
    "kind": "When kind_explicit, one of: offering, stone, bank, service, companion, pond, garden. Otherwise null",
    "target_name": "Bare name or kind-qualified name. Null when target is empty (capability-only URI)",
    "target_instance": "Instance qualifier from name:instance. Null when no instance",
    "sub_path": "Path after the target. Null when no sub-path",
    "capabilities": "Set of capabilities from cap= queries (sorted, deduped). Empty array when no cap",
    "action": "Value of action= query. Null when not present",
    "at": "Value of at= query (replica/stone pin). Null when not present",
    "tags": "Set of tags from tags= query (sorted, deduped). Empty array when no tags",
    "protocol_hint": "Value of protocol= query (resolver hint). Null when not present",
    "fragment": "Fragment without the leading '#'. Null when no fragment",
    "canonical": "Canonical string form. Two URIs that parse to equivalent intents MUST have equal canonical strings"
  },
