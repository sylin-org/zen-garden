{
  "version": 2,
  "name": "speech.tts",
  "display_name": "Text to Speech",
  "capability": "speech",
  "description": "Convert text to natural speech using TTS-Audio-Suite",
  "provider_kind": "comfy_ui",
  "vram_mb": 4096,
  "default_workflow": "tts",

  "content_slots": [
    { "role": "prompt", "content_type": "text", "required": true }
  ],

  "mappings": [
    { "type": "content", "role": "prompt", "content_type": "text",
      "placeholder": "PLACEHOLDER_TEXT" },

    { "type": "param", "field": "workflow", "label": "TTS Engine",
      "param_type": "options",
      "options": [
        { "value": "tts", "label": "ChatterBox (Natural)" },
        { "value": "tts_f5", "label": "F5-TTS (Multilingual)" }
      ],
      "default": "tts" },

    { "type": "param", "field": "exaggeration", "label": "Expressiveness",
      "node": "3", "input": "exaggeration",
      "param_type": "range",
      "min": 0.0, "max": 1.0, "step": 0.05,
      "default": 0.5 },

    { "type": "param", "field": "speed", "label": "Speed",
      "node": "3", "input": "speed",
      "param_type": "range",
      "min": 0.5, "max": 2.0, "step": 0.1,
      "default": 1.0 },

    { "type": "param", "field": "seed", "label": "Seed",
      "node": "3", "input": "seed",
      "param_type": "auto", "kind": "random_int" }
  ],

  "required_models": []
}
