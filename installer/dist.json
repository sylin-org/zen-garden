{
  "$schema": "./dist.schema.json",
  "version": "2.1",
  "description": "Zen Garden distribution - mirrors target filesystem structure",

  "workspace": {
    "root": "..",
    "dist": "../dist"
  },

  "staging": {
    "linux-x64": "../dist/staging/linux-x64",
    "linux-x86": "../dist/staging/linux-x86",
    "windows-x64": "../dist/staging/windows-x64",
    "linux-arm64-musl": "../dist/staging/linux-arm64-musl"
  },

  "packages": {
    "outputDir": "../dist/packages",
    "format": {
      "linux": "tar.gz",
      "windows": "zip"
    }
  },

  "tiers": {
    "core": ["moss", "rake"],
    "full": ["moss", "rake", "lantern", "cricket", "firefly"]
  },

  "binaries": {
    "moss": {
      "source": "garden-moss",
      "destination": "bin/",
      "required": true,
      "tier": "core",
      "platforms": ["linux", "windows"]
    },
    "rake": {
      "source": "garden-rake",
      "destination": "bin/",
      "required": true,
      "tier": "core",
      "platforms": ["linux", "windows"]
    },
    "lantern": {
      "source": "garden-lantern",
      "destination": "bin/",
      "required": false,
      "tier": "full",
      "platforms": ["linux", "windows"]
    },
    "cricket": {
      "source": "garden-cricket",
      "destination": "bin/companions/cricket/",
      "required": false,
      "tier": "full",
      "platforms": ["linux", "windows"]
    },
    "firefly": {
      "source": "garden-firefly",
      "destination": "bin/companions/firefly/",
      "required": false,
      "tier": "full",
      "platforms": ["linux", "windows"]
    }
  },

  "assets": {
    "_note": "BUILD-0003: shell scripts, service files, and garden.conf are no longer packaged. The garden-moss binary generates all system configuration during install."
  },
  
  "externalTools": {
    "directory": "../tools",
    "destination": "bin/tools/"
  },

  "build": {
    "profiles": {
      "debug": {
        "cargo": "--profile dev"
      },
      "fast-release": {
        "cargo": "--profile fast-release"
      },
      "release": {
        "cargo": "--release"
      }
    },
    "defaultProfile": "fast-release",
    "jobs": 0
  },
  
  "linux-x64": {
    "buildScript": "build-linux-x64.ps1",
    "distDir": "../dist/linux-x64",
    "architecture": "x64"
  },

  "linux-x86": {
    "buildScript": "build-linux-x86.ps1",
    "distDir": "../dist/linux-x86",
    "architecture": "x86"
  },

  "windows-x64": {
    "buildScript": "build-windows-x64.ps1",
    "distDir": "../dist/windows-x64",
    "architecture": "x64"
  },

  "android-arm64": {
    "buildScript": "build-android-arm64.ps1",
    "distDir": "../dist/linux-arm64-musl",
    "architecture": "arm64-musl"
  }
}
