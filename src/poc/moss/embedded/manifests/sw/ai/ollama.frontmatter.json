{
  "name": "ollama",
  "description": "Ollama local LLM runtime (MIT licensed)",
  "category": "ai",
  "tags": [
    "ai",
    "llm",
    "inference",
    "models",
    "gpu",
    "cuda",
    "local-ai"
  ],
  "port": 11434,
  "volumes": [
    "ollama-data"
  ],
  "gpu_recommended": true,
  "minimum_memory_gb": 4,
  "connection": {
    "uri_template": "http://{host}:{port}"
  },
  "manageable_env": {
    "service_name": "ollama",
    "restart_required": true,
    "vars": [
      "OLLAMA_NUM_PARALLEL",
      "OLLAMA_MAX_LOADED_MODELS",
      "OLLAMA_FLASH_ATTENTION",
      "OLLAMA_HOST"
    ]
  }
}
