# ── Build artifacts (hundreds of MB — the #1 context bloat source) ──
target/
**/target/
src/orchestrators/*/target/

# ── Node.js (rebuilt inside Docker) ──
**/node_modules/
src/orchestrators/ai/web/dist/

# ── Git history ──
.git/

# ── Build outputs ──
dist/
# Exception: cross-compiled ARM64 Stone binaries consumed by Dockerfile.stone-arm64
!dist/linux-arm64/garden-moss
!dist/linux-arm64/garden-rake
packages/
staging/

# ── IDE / tooling ──
.vscode/
.agentic/
.claude/

# ── Documentation (not needed in Docker builds) ──
docs/

# ── Installer scripts ──
installer/
scripts/

# ── Debug files ──
check-*.txt
*.pdb

# ── Crates not needed by orchestrators ──
# Orchestrators only use src/common/ + src/orchestrators/
src/moss/
src/rake/
src/lantern/
src/cricket/
src/firefly/
src/companion-sdk/
src/build-utils/
src/probe/

# ── Other orchestrators not needed by AI orchestrator ──
# The AI Dockerfile only copies src/orchestrators/ai/ and src/orchestrators/common/
# Other orchestrators are excluded to minimize context.
# If building a different orchestrator, comment out its exclusion.
src/orchestrators/ollama/target/
src/orchestrators/mongodb/target/
src/orchestrators/postgresql/target/
src/orchestrators/valkey/target/
src/orchestrators/weaviate/target/
