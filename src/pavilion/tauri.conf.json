{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pavilion",
  "version": "0.1.0",
  "identifier": "org.sylin.pavilion",
  "mainBinaryName": "garden-pavilion",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pavilion",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Sylin Org",
    "category": "DeveloperTool",
    "shortDescription": "Pavilion — Windows tray client for Zen Garden",
    "longDescription": "Pavilion is the Windows desktop client for the Zen Garden distributed infrastructure system. It provides tray-resident discovery, Cloud Filter file sync, and a unified dashboard for managing your garden of stones, services, and storage."
  }
}
