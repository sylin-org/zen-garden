{
  "name": "elasticsearch",
  "description": "Elasticsearch search and analytics engine (AGPL/SSPL licensed)",
  "category": "search",
  "tags": [
    "search",
    "database",
    "document",
    "analytics",
    "full-text",
    "vector"
